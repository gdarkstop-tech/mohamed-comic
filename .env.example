# Copy to .env (git-ignored) and fill in. Never commit the real .env.
# Or set these as environment variables / Claude Code cloud environment secrets.
#
# Account ID: Cloudflare dashboard -> Workers AI -> "Use REST API" (32 hex chars).
CLOUDFLARE_ACCOUNT_ID=
# API token: dashboard -> My Profile -> API Tokens -> Create Token -> "Workers AI" template.
# Optional extra permission for live usage checks: Account > Account Analytics > Read.
CLOUDFLARE_API_TOKEN=
